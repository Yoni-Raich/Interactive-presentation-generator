# LLM Provider Configuration
# Supported providers: gemini, ollama, openai, anthropic
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=your_api_key_here
# LLM_BASE_URL=http://localhost:11434  # For Ollama or other local providers
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048
LLM_TIMEOUT=30.0

# Legacy Google Gemini Configuration (deprecated but supported)
GOOGLE_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Provider-specific API keys (alternative to LLM_API_KEY)
# OPENAI_API_KEY=your_openai_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Content Generation Parameters
MAX_SUB_SUBJECTS=8
MIN_SUB_SUBJECTS=3
SLIDE_TEXT_MAX_LENGTH=500
SCRIPT_MIN_LENGTH=200

# API Retry and Rate Limiting
MAX_RETRIES=3
RATE_LIMIT_DELAY=1.0

# Output Configuration
OUTPUT_DIRECTORY=./output